# urljail control plane: Redis for the BullMQ queue (ADR 0019). Rootless podman, Quadlet.
[Unit]
Description=urljail control plane: Redis

[Container]
Image=@REDIS_IMAGE@
ContainerName=urljail-redis
PublishPort=127.0.0.1:56379:6379
Volume=urljail-redisdata:/data
Secret=urljail-redis-conf,type=mount,target=/usr/local/etc/redis/redis.conf
Exec=redis-server /usr/local/etc/redis/redis.conf
NoNewPrivileges=true

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
