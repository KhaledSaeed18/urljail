# urljail control plane: the orchestrator API (NestJS), as the operator (ADR 0019).
[Unit]
Description=urljail control plane: API
After=urljail-postgres.service urljail-redis.service
Wants=urljail-postgres.service urljail-redis.service

[Service]
EnvironmentFile=%h/.config/urljail/control-plane.env
WorkingDirectory=@REPO@/control-plane/api
ExecStart=@NODE@ dist/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
