{
  "$defs": {
    "google.protobuf.Timestamp.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "urljail.report.v0.Artifacts.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Paths relative to the run directory; empty when the file wasn't produced.",
      "patternProperties": {
        "^(chromeLog)$": {
          "default": "",
          "type": "string"
        },
        "^(firecrackerLog)$": {
          "default": "",
          "type": "string"
        },
        "^(serialLog)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "chrome_log": {
          "default": "",
          "type": "string"
        },
        "dom": {
          "default": "",
          "type": "string"
        },
        "events": {
          "default": "",
          "type": "string"
        },
        "firecracker_log": {
          "default": "",
          "type": "string"
        },
        "pcap": {
          "default": "",
          "description": "Host packet capture; empty once retention deleted it (see gaps).",
          "type": "string"
        },
        "screenshot": {
          "default": "",
          "type": "string"
        },
        "serial_log": {
          "default": "",
          "type": "string"
        },
        "sslkeylog": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Artifacts",
      "type": "object"
    },
    "urljail.report.v0.Blocked.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(dstIp)$": {
          "default": "",
          "type": "string"
        },
        "^(dstPort)$": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        }
      },
      "properties": {
        "count": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "dst_ip": {
          "default": "",
          "type": "string"
        },
        "dst_port": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "first": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "proto": {
          "default": "",
          "type": "string"
        },
        "reason": {
          "default": "",
          "description": "\"private\", \"quic\", \"other\" or \"input\".",
          "type": "string"
        },
        "source": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Blocked",
      "type": "object"
    },
    "urljail.report.v0.Clone.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(guestClockSkewMs)$": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Guest wall clock against the host's right after restore."
        },
        "^(vmgenidReseed)$": {
          "default": false,
          "description": "The guest kernel reseeded its RNG on restore (VMGenID).",
          "type": "boolean"
        }
      },
      "properties": {
        "guest_clock_skew_ms": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Guest wall clock against the host's right after restore."
        },
        "snapshot": {
          "default": "",
          "type": "string"
        },
        "vmgenid_reseed": {
          "default": false,
          "description": "The guest kernel reseeded its RNG on restore (VMGenID).",
          "type": "boolean"
        }
      },
      "title": "Clone",
      "type": "object"
    },
    "urljail.report.v0.Dialog.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "message": {
          "default": "",
          "type": "string"
        },
        "source": {
          "default": "",
          "type": "string"
        },
        "type": {
          "default": "",
          "description": "\"alert\", \"confirm\", \"prompt\" or \"beforeunload\". Dialogs are dismissed automatically.",
          "type": "string"
        },
        "url": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Dialog",
      "type": "object"
    },
    "urljail.report.v0.DnsQuery.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cached": {
          "default": false,
          "type": "boolean"
        },
        "label": {
          "default": "",
          "description": "\"page\", \"page-hint\", \"page-report\", \"browser-background\" or \"unexplained\" (see Reconciliation).",
          "type": "string"
        },
        "qname": {
          "default": "",
          "type": "string"
        },
        "qtype": {
          "default": "",
          "type": "string"
        },
        "rcode": {
          "default": "",
          "type": "string"
        },
        "source": {
          "default": "",
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        }
      },
      "title": "Dns Query",
      "type": "object"
    },
    "urljail.report.v0.Domain.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "registrable": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Domain",
      "type": "object"
    },
    "urljail.report.v0.Download.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "filename": {
          "default": "",
          "type": "string"
        },
        "source": {
          "default": "",
          "type": "string"
        },
        "state": {
          "default": "",
          "description": "Last state Chrome reported: \"inProgress\", \"completed\" or \"canceled\".",
          "type": "string"
        },
        "url": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Download",
      "type": "object"
    },
    "urljail.report.v0.Egress.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "exit": {
          "default": "",
          "description": "Exit identity in live mode, e.g. \"wg:mullvad-de-fra-001\".",
          "type": "string"
        },
        "mode": {
          "default": "",
          "description": "\"dev\" (host NAT) or \"live\" (WireGuard).",
          "type": "string"
        }
      },
      "title": "Egress",
      "type": "object"
    },
    "urljail.report.v0.Feed.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(feedTime)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json",
          "description": "The feed's own time for the URL, when it has one (URLhaus date_added)."
        },
        "^(firstSeen)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json",
          "description": "When urljail first saw the URL in the feed (the feed has no per-URL time)."
        }
      },
      "properties": {
        "feed_time": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json",
          "description": "The feed's own time for the URL, when it has one (URLhaus date_added)."
        },
        "first_seen": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json",
          "description": "When urljail first saw the URL in the feed (the feed has no per-URL time)."
        },
        "name": {
          "default": "",
          "description": "Source, e.g. \"openphish-community\".",
          "type": "string"
        }
      },
      "title": "Feed",
      "type": "object"
    },
    "urljail.report.v0.Field.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "",
          "type": "string"
        },
        "type": {
          "default": "",
          "description": "The input's type attribute, lowercase (\"text\" when unset); \"select\" or \"textarea\" for those.",
          "type": "string"
        }
      },
      "title": "Field",
      "type": "object"
    },
    "urljail.report.v0.Flow.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(bytesIn)$": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(bytesOut)$": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(dstIp)$": {
          "default": "",
          "description": "Destination as the guest addressed it (before NAT).",
          "type": "string"
        },
        "^(dstPort)$": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(httpHost)$": {
          "default": "",
          "description": "Host header of a plain-HTTP request (the HTTP counterpart of sni).",
          "type": "string"
        },
        "^(packetsIn)$": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(packetsOut)$": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(tcpFlagsOut)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "alpn": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "bytes_in": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "bytes_out": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "dst_ip": {
          "default": "",
          "description": "Destination as the guest addressed it (before NAT).",
          "type": "string"
        },
        "dst_port": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "first": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "http_host": {
          "default": "",
          "description": "Host header of a plain-HTTP request (the HTTP counterpart of sni).",
          "type": "string"
        },
        "label": {
          "default": "",
          "description": "\"page\" (matches a guest request), \"page-hint\" (a host the page's \u003clink rel=preconnect,\n dns-prefetch, prefetch, preload\u003e named), \"page-report\" (a Reporting API / NEL endpoint the\n page's response headers named), \"browser-background\" (Chrome's own traffic, not\n requested by the page), \"dns\" (to our resolver, including the guest's ICMP errors for late\n replies), \"no-data\" (no payload exchanged:\n preconnects, blocked attempts) or \"unexplained\".",
          "type": "string"
        },
        "last": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "packets_in": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "packets_out": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "proto": {
          "default": "",
          "type": "string"
        },
        "sni": {
          "default": "",
          "description": "From the TLS ClientHello, read outside the guest.",
          "type": "string"
        },
        "source": {
          "default": "",
          "type": "string"
        },
        "tcp_flags_out": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Flow",
      "type": "object"
    },
    "urljail.report.v0.Form.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(crossOriginAction)$": {
          "default": false,
          "description": "The action's registrable domain differs from the final URL's: the form sends what's typed\n somewhere else.",
          "type": "boolean"
        },
        "^(hasPassword)$": {
          "default": false,
          "type": "boolean"
        }
      },
      "properties": {
        "action": {
          "default": "",
          "description": "The action resolved against the final URL; the final URL itself when the form has none.",
          "type": "string"
        },
        "cross_origin_action": {
          "default": false,
          "description": "The action's registrable domain differs from the final URL's: the form sends what's typed\n somewhere else.",
          "type": "boolean"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/urljail.report.v0.Field.schema.json"
          },
          "type": "array"
        },
        "has_password": {
          "default": false,
          "type": "boolean"
        },
        "method": {
          "default": "",
          "description": "\"get\" or \"post\" (lowercase; \"get\" when unset, as browsers do).",
          "type": "string"
        },
        "source": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Form",
      "type": "object"
    },
    "urljail.report.v0.Hop.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "",
          "description": "How the main frame got to this URL: \"initial\", \"http\" (3xx redirect), \"js\" (script),\n \"meta\" (meta refresh), \"header\" (Refresh header) or \"other\".",
          "type": "string"
        },
        "source": {
          "default": "",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "HTTP status of this URL's response; 0 if none arrived."
        },
        "url": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Hop",
      "type": "object"
    },
    "urljail.report.v0.Indicator.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "brand": {
          "default": "",
          "description": "The impersonated brand's ID (internal/brands), when the indicator is about one.",
          "type": "string"
        },
        "detail": {
          "default": "",
          "description": "One sentence saying what was seen.",
          "type": "string"
        },
        "id": {
          "default": "",
          "description": "Stable name: \"password-form-cross-origin\", \"brand-name-off-domain\", \"brand-look-off-domain\".",
          "type": "string"
        },
        "severity": {
          "default": "",
          "description": "\"medium\" or \"high\".",
          "type": "string"
        },
        "source": {
          "default": "",
          "description": "Where the evidence came from (\"guest.dom\", \"guest.screenshot\").",
          "type": "string"
        }
      },
      "title": "Indicator",
      "type": "object"
    },
    "urljail.report.v0.Navigation.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(dwellMs)$": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(dwellReason)$": {
          "default": "",
          "description": "\"network idle\", \"max dwell\" or \"cancelled\".",
          "type": "string"
        },
        "^(finalUrl)$": {
          "default": "",
          "type": "string"
        },
        "^(redirectChain)$": {
          "description": "Every URL the main frame loaded, in order, starting with the submitted URL.",
          "items": {
            "$ref": "#/$defs/urljail.report.v0.Hop.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "dwell_ms": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "dwell_reason": {
          "default": "",
          "description": "\"network idle\", \"max dwell\" or \"cancelled\".",
          "type": "string"
        },
        "error": {
          "default": "",
          "description": "Set when the navigation itself failed, e.g. \"net::ERR_NAME_NOT_RESOLVED\".",
          "type": "string"
        },
        "final_url": {
          "default": "",
          "type": "string"
        },
        "redirect_chain": {
          "description": "Every URL the main frame loaded, in order, starting with the submitted URL.",
          "items": {
            "$ref": "#/$defs/urljail.report.v0.Hop.schema.json"
          },
          "type": "array"
        },
        "title": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Navigation",
      "type": "object"
    },
    "urljail.report.v0.Network.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "blocked": {
          "description": "Packets the egress firewall dropped, grouped by destination (source host.fw).",
          "items": {
            "$ref": "#/$defs/urljail.report.v0.Blocked.schema.json"
          },
          "type": "array"
        },
        "dns": {
          "description": "Every DNS reply our resolver sent the VM (source host.dns).",
          "items": {
            "$ref": "#/$defs/urljail.report.v0.DnsQuery.schema.json"
          },
          "type": "array"
        },
        "domains": {
          "description": "Hosts contacted, grouped by registrable domain (eTLD+1).",
          "items": {
            "$ref": "#/$defs/urljail.report.v0.Domain.schema.json"
          },
          "type": "array"
        },
        "flows": {
          "description": "Every connection on the VM's TAP, from the guest's side (source host.ebpf).",
          "items": {
            "$ref": "#/$defs/urljail.report.v0.Flow.schema.json"
          },
          "type": "array"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/urljail.report.v0.Request.schema.json"
          },
          "type": "array"
        },
        "tls": {
          "description": "One entry per host with a TLS connection.",
          "items": {
            "$ref": "#/$defs/urljail.report.v0.Tls.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Network",
      "type": "object"
    },
    "urljail.report.v0.Page.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(passwordFields)$": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Password inputs anywhere in the top document, in a form or not (script-driven logins often\n have no \u003cform\u003e)."
        },
        "^(screenshotBlank)$": {
          "default": false,
          "description": "The screenshot exists but is one colour, or nearly (no useful hash).",
          "type": "boolean"
        },
        "^(screenshotPhash)$": {
          "default": "",
          "description": "Perceptual hash of the screenshot (64-bit DCT pHash, 16 hex digits; internal/visual).\n Screenshots that look alike are a few bits apart: a distance of 6 or less found no false\n matches between different loaded pages in P7's 761-page corpus. Empty when there's no\n screenshot or it's blank.",
          "type": "string"
        }
      },
      "properties": {
        "dialogs": {
          "items": {
            "$ref": "#/$defs/urljail.report.v0.Dialog.schema.json"
          },
          "type": "array"
        },
        "downloads": {
          "items": {
            "$ref": "#/$defs/urljail.report.v0.Download.schema.json"
          },
          "type": "array"
        },
        "forms": {
          "description": "Forms in the final DOM (guest/dom.html, the top document only: forms inside iframes\n aren't in it). At most 32 forms of 64 fields each.",
          "items": {
            "$ref": "#/$defs/urljail.report.v0.Form.schema.json"
          },
          "type": "array"
        },
        "password_fields": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Password inputs anywhere in the top document, in a form or not (script-driven logins often\n have no \u003cform\u003e)."
        },
        "screenshot_blank": {
          "default": false,
          "description": "The screenshot exists but is one colour, or nearly (no useful hash).",
          "type": "boolean"
        },
        "screenshot_phash": {
          "default": "",
          "description": "Perceptual hash of the screenshot (64-bit DCT pHash, 16 hex digits; internal/visual).\n Screenshots that look alike are a few bits apart: a distance of 6 or less found no false\n matches between different loaded pages in P7's 761-page corpus. Empty when there's no\n screenshot or it's blank.",
          "type": "string"
        }
      },
      "title": "Page",
      "type": "object"
    },
    "urljail.report.v0.Reconciliation.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(backgroundFlows)$": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(guestOnlyRequests)$": {
          "description": "Guest requests that should have crossed the network (not cached, with a remote address)\n but match no host flow: served some other way, or reported falsely.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "^(pageFlows)$": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(unexplainedDns)$": {
          "description": "DNS names the host resolved for the VM that no guest request explains.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "^(unexplainedFlows)$": {
          "description": "Connections the host saw that the guest's browser never reported and that aren't known\n browser-background traffic.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "properties": {
        "background_flows": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "consistent": {
          "default": false,
          "description": "True when every host flow is explained (page, background, dns, no-data) and every guest\n request that should have crossed the network was seen by the host.",
          "type": "boolean"
        },
        "guest_only_requests": {
          "description": "Guest requests that should have crossed the network (not cached, with a remote address)\n but match no host flow: served some other way, or reported falsely.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "page_flows": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "unexplained_dns": {
          "description": "DNS names the host resolved for the VM that no guest request explains.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unexplained_flows": {
          "description": "Connections the host saw that the guest's browser never reported and that aren't known\n browser-background traffic.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Reconciliation",
      "type": "object"
    },
    "urljail.report.v0.Report.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Report is derived from a run's raw artifacts and can always be regenerated from them.\n Every observation says who attests to it in `source`: \"guest.cdp\" (Chrome, inside the VM:\n guest-attested evidence) or \"host.*\" (observed outside the VM, from P3).",
      "properties": {
        "artifacts": {
          "$ref": "#/$defs/urljail.report.v0.Artifacts.schema.json"
        },
        "gaps": {
          "description": "What could not be observed in this run, stated explicitly (design goal G4).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "indicators": {
          "description": "Explainable signals that the page is phishing, each with its reason (internal/report/\n indicators.go). None is a verdict on its own.",
          "items": {
            "$ref": "#/$defs/urljail.report.v0.Indicator.schema.json"
          },
          "type": "array"
        },
        "navigation": {
          "$ref": "#/$defs/urljail.report.v0.Navigation.schema.json"
        },
        "network": {
          "$ref": "#/$defs/urljail.report.v0.Network.schema.json"
        },
        "page": {
          "$ref": "#/$defs/urljail.report.v0.Page.schema.json"
        },
        "reconciliation": {
          "$ref": "#/$defs/urljail.report.v0.Reconciliation.schema.json",
          "description": "The host's view of the network against the guest's (design goal G2)."
        },
        "run": {
          "$ref": "#/$defs/urljail.report.v0.Run.schema.json"
        },
        "schema": {
          "default": "",
          "description": "\"urljail.report/v0\".",
          "type": "string"
        }
      },
      "title": "Report",
      "type": "object"
    },
    "urljail.report.v0.Request.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(fromCache)$": {
          "default": false,
          "type": "boolean"
        },
        "^(remoteIp)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "bytes": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Bytes received on the wire (encoded length)."
        },
        "error": {
          "default": "",
          "description": "Set when the request failed, e.g. \"net::ERR_CONNECTION_REFUSED\".",
          "type": "string"
        },
        "from_cache": {
          "default": false,
          "type": "boolean"
        },
        "initiator": {
          "default": "",
          "description": "What started the request: \"parser\", \"script\", \"redirect\", \"other\", ...",
          "type": "string"
        },
        "method": {
          "default": "",
          "type": "string"
        },
        "protocol": {
          "default": "",
          "description": "Network protocol, e.g. \"h2\", \"http/1.1\".",
          "type": "string"
        },
        "remote_ip": {
          "default": "",
          "type": "string"
        },
        "source": {
          "default": "",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "type": {
          "default": "",
          "description": "Chrome's resource type: \"Document\", \"Script\", \"Image\", \"XHR\", ...",
          "type": "string"
        },
        "url": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Request",
      "type": "object"
    },
    "urljail.report.v0.Run.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(endedAt)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "^(startedAt)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "^(submittedUrl)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "clone": {
          "$ref": "#/$defs/urljail.report.v0.Clone.schema.json",
          "description": "Set when the VM was restored from a snapshot (P4)."
        },
        "egress": {
          "$ref": "#/$defs/urljail.report.v0.Egress.schema.json"
        },
        "ended_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "error": {
          "default": "",
          "type": "string"
        },
        "feed": {
          "$ref": "#/$defs/urljail.report.v0.Feed.schema.json",
          "description": "Set when the URL came from a feed (urljail feeds, P6)."
        },
        "id": {
          "default": "",
          "description": "UUIDv7.",
          "type": "string"
        },
        "profile": {
          "default": "",
          "type": "string"
        },
        "started_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "status": {
          "default": "",
          "description": "\"completed\", \"timeout\", \"cancelled\", \"error\", or \"interrupted\" (the daemon stopped\n during the run; recovered at its next start).",
          "type": "string"
        },
        "submitted_url": {
          "default": "",
          "type": "string"
        },
        "versions": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Component versions: urljail, firecracker, image, guest_kernel, browser, snapshot.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "title": "Run",
      "type": "object"
    },
    "urljail.report.v0.Tls.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(notAfter)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "^(notBefore)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        }
      },
      "properties": {
        "host": {
          "default": "",
          "type": "string"
        },
        "issuer": {
          "default": "",
          "type": "string"
        },
        "not_after": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "not_before": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "protocol": {
          "default": "",
          "type": "string"
        },
        "san": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "default": "",
          "type": "string"
        },
        "subject": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Tls",
      "type": "object"
    }
  },
  "$id": "urljail.report.v0.Report.schema.bundle.json",
  "$ref": "#/$defs/urljail.report.v0.Report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
