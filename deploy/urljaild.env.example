# /etc/urljail/urljaild.env (root-owned, 0600)
URLJAIL_OPERATOR=khaledsaeed18
# dev | live-test | live. live also needs the WireGuard config below, and refuses to start
# while /etc/sudoers.d/urljail-dev exists.
URLJAIL_EGRESS=dev
# For live: URLJAIL_EXTRA_ARGS=-wg-config /etc/urljail/wg0.conf -exit-timezone America/Chicago
# (-exit-timezone: the VPN exit's IANA zone, for the stealth profiles; see docs/research/anti-cloaking.md)
URLJAIL_EXTRA_ARGS=
